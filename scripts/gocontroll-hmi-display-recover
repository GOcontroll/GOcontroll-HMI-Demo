#!/bin/sh
# Keep the display alive across short power interruptions.
#
# Runs as a single long-lived service: it first repairs whatever the boot left
# broken, reports readiness so the splash can open /dev/dri/card1, and then
# keeps watching for the one failure mode that happens while the system runs.
#
#   gocontroll-hmi-display-recover           recover, then watch (the service)
#   gocontroll-hmi-display-recover --check   report state, change nothing
#
# Three failure modes have been observed on a Moduline HMI1, all triggered by
# briefly interrupting the supply. Each leaves a black screen while the
# controller itself runs fine and SSH works.
#
# --- Mode 1: i2c-3 comes up with SCL stuck low (boot) ------------------------
#
# i2c-3 (30a50000.i2c) registers with SCL held low. GPIO recovery cannot fix it
# — that only clocks out a slave holding SDA — so every probe on the bus fails:
#
#   i2c i2c-3: SCL is stuck low, exit recovery
#   max25014 3-006f: probe with driver max25014 failed with error -11
#
# -EAGAIN is a terminal probe failure; only -EPROBE_DEFER gets retried. The
# panel node lists the MAX25014 backlight as its supplier, so a failed 0x6f
# probe strands the whole chain:
#
#   max25014 3-006f  ->  panel  ->  bridge@5c  ->  display-controller
#
# and /dev/dri/card1 is never created. The bus un-sticks within seconds, so
# binding the drivers that gave up too early is enough.
#
# --- Mode 2: bound and probed, but never programmed (boot) -------------------
#
# The boot looks healthy — no stuck SCL, all four slaves bound, card1 present,
# DRM scanning out — and there is no light. The driver programmed the chip
# while its rail was still rising, so the config writes were lost while the
# final read still succeeded and probe reported success.
#
# --- Mode 3: the chip PORs while the SoC keeps running (runtime) -------------
#
# The one no boot-time check can ever catch. On a short enough interruption the
# i.MX8MP rides through on its own bulk capacitance and never resets, so
# nothing re-runs any initialisation — but the display-side rail does sag below
# the MAX25014's POR threshold. The chip resets to its power-on defaults and
# the backlight goes out for good, while from the SoC's point of view
# everything is still initialised and fine. The chip has no interrupt in the
# device tree, so polling is the only way to notice.
#
#   register    0x02  0x03  0x12  0x13
#   programmed  0x37  0x04  0x03  0x08
#   POR default 0x1b  0x08  0x13  0x00
#
# 0x04/0x05 track brightness and are deliberately not checked.
set -u

GATING_DEV=3-006f
GATING_DRV=max25014
EXTRA="3-0024:cyttsp6_i2c_adapter 3-0051:rtc-pcf85063"

I2C_BUS=3
I2C_ADDR=0x6f
BL=/sys/class/backlight/max25014

# EN pin of the MAX25014 (backlight@6f enable-gpios = <&gpio1 4>). Pulsing it
# low also clears latched faults, which a plain rebind does not.
EN_CHIP=gpiochip0
EN_LINE=4

# Empirical, from a working unit — see the table above. Only used to decide
# whether to re-run probe; a wrong expectation costs a harmless extra rebind,
# never a broken display.
CONFIG_REGS="0x02 0x03 0x12 0x13"
CONFIG_WANT="0x37 0x04 0x03 0x08"

BIND_DEADLINE=20
INTERVAL=2

bound() { [ -e "/sys/bus/i2c/devices/$1/driver" ]; }
now() { cut -d. -f1 /proc/uptime; }

try_bind() {
	dev=${1%%:*}
	drv=${1#*:}
	bound "$dev" && return 0
	[ -d "/sys/bus/i2c/drivers/$drv" ] || return 1
	echo "$dev" > "/sys/bus/i2c/drivers/$drv/bind" 2>/dev/null || return 1
}

# Needs -f because the driver holds the device. Prints nothing on failure.
read_config() {
	out=
	for r in $CONFIG_REGS; do
		v=$(i2cget -y -f "$I2C_BUS" "$I2C_ADDR" "$r" 2>/dev/null) || return 1
		out="${out:+$out }$v"
	done
	echo "$out"
}

bind_with_retry() {
	deadline=$(($(now) + BIND_DEADLINE))
	while :; do
		try_bind "$GATING_DEV:$GATING_DRV"
		bound "$GATING_DEV" && return 0
		[ "$(now)" -ge "$deadline" ] && return 1
		sleep 1
	done
}

# Stronger reset: hold EN low while the driver is detached. gpioset keeps the
# line until killed, and it reverts to its pulled-up state once released.
reset_chip() {
	echo "$GATING_DEV" > "/sys/bus/i2c/drivers/$GATING_DRV/unbind" 2>/dev/null
	if command -v gpioset >/dev/null 2>&1; then
		timeout 1 gpioset -c "$EN_CHIP" "$EN_LINE=0" >/dev/null 2>&1
		sleep 1
	fi
	bind_with_retry
}

# Re-running probe resets brightness to the device tree default, which would
# silently throw away whatever the HMI had set. Carry it across the repair.
repair() {
	saved_bright=$(cat "$BL/brightness" 2>/dev/null)
	saved_power=$(cat "$BL/bl_power" 2>/dev/null)

	# A plain rebind is ~350 ms and fixes a chip that merely lost its config.
	echo "$GATING_DEV" > "/sys/bus/i2c/drivers/$GATING_DRV/unbind" 2>/dev/null
	bind_with_retry || { echo "repair: rebind failed"; return 1; }

	if [ "$(read_config)" != "$CONFIG_WANT" ]; then
		echo "repair: config still wrong after rebind, cycling EN"
		reset_chip || { echo "repair: reset failed"; return 1; }
	fi

	[ -n "${saved_bright:-}" ] && echo "$saved_bright" > "$BL/brightness" 2>/dev/null
	[ -n "${saved_power:-}" ] && echo "$saved_power" > "$BL/bl_power" 2>/dev/null

	got=$(read_config)
	if [ "$got" = "$CONFIG_WANT" ]; then
		echo "repair: ok, config [$got], brightness ${saved_bright:-?}"
		return 0
	fi
	echo "repair: config still [$got] — backlight may stay dark"
	return 1
}

# The same dip that PORs the backlight chip also resets the panel controller.
# panel-simple has no way to notice: it still believes the panel is prepared and
# enabled, so it never re-runs its reset and init sequence. The LCDIF keeps
# scanning out valid pixels into a panel that is not listening, which looks
# exactly like a healthy pipeline with a black screen — crtc active, connector
# on, the HMI's framebuffer bound, and nothing to see.
#
# Only a modeset re-runs panel-simple's disable/enable. While the HMI holds DRM
# master the connector's dpms attribute is not writable, so the practical way to
# force one is to restart the HMI: it drops master, fbdev takes over and
# re-enables the panel, and the HMI then does its own fresh modeset.
#
# --no-block matters: `systemctl restart` on this unit does not return promptly,
# and the watch loop must not stall behind it.
# Rate limited: a supply that keeps browning out would otherwise restart the HMI
# every few seconds, which is worse than one black screen.
last_kick=0
KICK_MIN_GAP=60

kick_display() {
	systemctl is-active --quiet gocontroll-hmi-demo.service 2>/dev/null || return 0

	t=$(now)
	if [ "$last_kick" -ne 0 ] && [ $((t - last_kick)) -lt "$KICK_MIN_GAP" ]; then
		echo "panel re-init skipped, last one was $((t - last_kick))s ago"
		return 0
	fi
	last_kick=$t

	echo "restarting the HMI so panel-simple re-runs its init"
	systemctl restart --no-block gocontroll-hmi-demo.service 2>/dev/null
}

# --- preconditions -----------------------------------------------------------

# Not this hardware, or the driver isn't loaded — nothing to do, and no reason
# to hold up the boot.
[ -d "/sys/bus/i2c/devices/$GATING_DEV" ] || exit 0
[ -d "/sys/bus/i2c/drivers/$GATING_DRV" ] || exit 0

if [ "${1:-}" = "--check" ]; then
	if bound "$GATING_DEV"; then echo "bound:  yes"; else echo "bound:  no"; fi
	echo "config: [$(read_config)] want [$CONFIG_WANT]"
	echo "card1:  $([ -e /dev/dri/card1 ] && echo present || echo missing)"
	echo "bright: $(cat "$BL/brightness" 2>/dev/null || echo -)"
	exit 0
fi

# --- repair whatever the boot left broken (modes 1 and 2) --------------------

if ! bound "$GATING_DEV"; then
	echo "boot: $GATING_DEV unbound (stuck-SCL boot), binding"
	bind_with_retry || echo "boot: $GATING_DEV still unbound after ${BIND_DEADLINE}s"
fi

if bound "$GATING_DEV"; then
	got=$(read_config) || got=
	if [ -z "$got" ]; then
		echo "boot: could not read backlight config registers"
	elif [ "$got" != "$CONFIG_WANT" ]; then
		echo "boot: config is [$got], expected [$CONFIG_WANT] — repairing"
		# kick_display is a no-op this early (the HMI is not up yet), but keep
		# it symmetric in case this path ever runs late.
		repair && kick_display
	fi
fi

for dev in $EXTRA; do
	try_bind "$dev" || echo "boot: could not bind ${dev%%:*} (non-fatal)"
done

# Binding the backlight only releases the deferred-probe chain; the DRM node
# appears a moment later. Hold off readiness so the splash does not race us.
deadline=$(($(now) + 5))
while [ ! -e /dev/dri/card1 ]; do
	[ "$(now)" -ge "$deadline" ] && break
	sleep 1
done
[ -e /dev/dri/card1 ] || echo "boot: /dev/dri/card1 did not appear"

# Let the splash and the HMI proceed. Deliberately unconditional: if the
# display is still broken the watch loop below keeps trying, and blocking the
# boot forever would help nobody.
command -v systemd-notify >/dev/null 2>&1 && systemd-notify --ready 2>/dev/null

# --- keep watching (mode 3) --------------------------------------------------

bad=0
while :; do
	sleep "$INTERVAL"

	if ! bound "$GATING_DEV"; then
		echo "backlight driver unbound, rebinding"
		bind_with_retry || echo "rebind failed"
		bad=0
		continue
	fi

	got=$(read_config) || got=
	if [ -z "$got" ]; then
		# A single failed read can happen while the driver is busy; only act
		# if it keeps failing.
		bad=$((bad + 1))
		[ "$bad" -lt 2 ] && continue
		echo "backlight not responding on i2c, resetting"
		repair && kick_display
		bad=0
		continue
	fi

	if [ "$got" = "$CONFIG_WANT" ]; then
		bad=0
		continue
	fi

	# Require two consecutive readings before touching anything, so we never
	# fight the driver mid-operation.
	bad=$((bad + 1))
	[ "$bad" -lt 2 ] && continue
	echo "config is [$got], expected [$CONFIG_WANT] — chip lost its programming (POR?)"
	# The panel almost certainly took the same dip, so re-init it as well.
	repair && kick_display
	bad=0
done
