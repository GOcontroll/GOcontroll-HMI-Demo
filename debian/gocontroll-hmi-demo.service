[Unit]
Description=GOcontroll LVGL HMI demo (direct KMS, no compositor)
# Start after the Simulink backend so IPC target exists, and after getty@tty1
# has set up the VT.
#
# Deliberately NOT ordered after systemd-user-sessions.service: that unit pulls
# in network.target -> NetworkManager and only exists to clear /run/nologin for
# login sessions, neither of which a direct-KMS app needs. On an HMI1 it delayed
# us by ~1.0s — the Simulink backend was ready at 1.7s while user-sessions did
# not settle until 3.7s.
After=gocontroll_demo.service
Wants=gocontroll_demo.service
# Replace getty@tty1 so we own the VT and can grab DRM master.
Conflicts=getty@tty1.service
After=getty@tty1.service
PartOf=graphical.target

[Service]
Type=simple
# Synchronously stop the splash before grabbing DRM master. A unit-level
# Conflicts= is unreliable at boot: both units are in the same transaction
# and systemd drops the stop-job, leaving the splash holding DRM master.
ExecStartPre=-/bin/systemctl stop gocontroll-hmi-splash.service
ExecStart=/usr/bin/gocontroll-hmi-demo
# Attach to tty1 so the kernel VT handover works cleanly for DRM master.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# The Simulink IPC uses process_vm_readv/writev; needs CAP_SYS_PTRACE unless we
# disable dumpable. Simpler: run as root (matches go-gtk-demo's posture).
User=root

[Install]
WantedBy=graphical.target
