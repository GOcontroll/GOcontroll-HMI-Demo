[Unit]
Description=Recover the display backlight after a bad start or a supply dip
DefaultDependencies=no
# The i2c slaves are probed during kernel init, so their verdict is already in
# by the time systemd runs. Go before anything that wants /dev/dri/card1.
After=systemd-udevd.service
Before=gocontroll-hmi-splash.service basic.target
Conflicts=shutdown.target

[Service]
# Type=notify so the splash really waits for the initial repair: the script
# signals readiness only once it has stopped trying to produce card1. It then
# stays alive to catch a backlight POR during normal operation, which no
# one-shot unit could ever see.
Type=notify
# systemd-notify is a separate process, so the default (main process only)
# would reject the notification.
NotifyAccess=all
ExecStart=/usr/bin/gocontroll-hmi-display-recover
Restart=always
RestartSec=5s
# The initial repair self-limits to ~30s; give it headroom rather than a kill.
TimeoutStartSec=60s
StandardOutput=journal
StandardError=journal
User=root

[Install]
WantedBy=sysinit.target
