[Unit]
Description=GOcontroll boot splash (DRM, pre-HMI)
DefaultDependencies=no
# Neither systemd-tmpfiles-setup nor local-fs.target is a real precondition:
# /dev/dri/card1 is created by devtmpfs when the DRM device registers, and the
# asset sits on the root fs, which the kernel already mounted (/usr is not a
# separate mount). Ordering behind them cost ~0.7s of black screen on an HMI1 —
# the framebuffer is up at 0.72s but tmpfiles-setup only finished at 2.0s.
# The actual gate is /dev/dri/card1 itself: the binary waits for it (up to
# 15 s), because the kernel can take seconds to bring the display chain up
# when i2c-3 is busy after a short power interruption.
After=systemd-udevd.service
Before=basic.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/gocontroll-hmi-splash
StandardInput=null
StandardOutput=journal
StandardError=journal
# Don't respawn — the main HMI deliberately kicks us via Conflicts=.
Restart=no
# systemd sends SIGTERM on stop; sigwait in the binary handles it in ms.
TimeoutStopSec=5s
User=root

[Install]
WantedBy=sysinit.target
